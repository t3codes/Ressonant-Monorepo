# Infra compartilhada (Postgres e observabilidade). Variáveis de cada app: apps/<app>/.env.example.
# `make setup` copia este arquivo para .env (não versionado).
# Valores abaixo servem só para ambiente local.

POSTGRES_USER=ressonant
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ressonant
POSTGRES_PORT=5432

# Grafana: http://localhost:3001 (GRAFANA_PORT)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=ressonant-dev
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090
OTLP_HTTP_PORT=4318

BACKEND_PORT=8000
