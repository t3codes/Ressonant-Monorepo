# Infra compartilhada (Postgres e observabilidade). Variáveis de cada app: apps/<app>/.env.example.
# `make setup` copia este arquivo para .env (não versionado).
# Valores abaixo servem só para ambiente local.

POSTGRES_USER=ressonant
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ressonant
POSTGRES_PORT=5432

# Grafana: http://localhost:3001 (GRAFANA_PORT)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=ressonant-dev
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090
OTLP_HTTP_PORT=4318

BACKEND_PORT=8000

# Planejado — Fase 0/1 (D1, frontend — NÃO implementado neste monorepo):
# a configuração do cliente passará a usar uma única variável de URL
# (VITE_API_BASE_URL) e um flag de modo (VITE_DATA_MODE=mock|http).
# Hoje nenhuma variável VITE_* é lida por este monorepo: as variáveis atuais
# do frontend vivem no repositório do frontend, fora daqui.
