    {
      "name": "Users",
      "description": "CRUD de usuários (admin onde indicado). Requer Bearer {{accessToken}}.",
      "item": [
        {
          "name": "Create User (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"usuario@example.com\",\n  \"cpf\": \"12345678901\",\n  \"telefone\": \"11987654321\",\n  \"senha\": \"SenhaForte123\",\n  \"idade\": 30,\n  \"termos_contrato\": true,\n  \"status_ativo\": true,\n  \"interno_adm\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "description": "Cria usuário (admin), podendo definir flags administrativas (UserCreate). Também salva {{userId}}."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status code e 201\", function () { pm.response.to.have.status(201); });",
                  "try {",
                  "  const json = pm.response.json();",
                  "  if (json && json.id) { pm.collectionVariables.set('userId', json.id); }",
                  "} catch (e) { console.log('create user: sem corpo JSON de resposta', e); }"
                ]
              }
            }
