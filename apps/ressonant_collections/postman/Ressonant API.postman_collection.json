        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users?skip={{skip}}&limit={{limit}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ],
              "query": [
                {
                  "key": "skip",
                  "value": "{{skip}}"
                },
                {
                  "key": "limit",
                  "value": "{{limit}}"
                },
                {
                  "key": "status_ativo",
                  "value": "{{status_ativo}}",
                  "disabled": true,
                  "description": "Opcional: true/false. Omitido, lista todos."
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "description": "Lista usuários com paginação; `status_ativo` filtra, omitido traz todos."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status code e 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
