  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Pré-requisito global: garante que baseUrl esteja definida (coleção ou ambiente).",
          "if (!pm.collectionVariables.get('baseUrl') && !(pm.environment && pm.environment.get('baseUrl'))) {",
          "  pm.collectionVariables.set('baseUrl', 'http://localhost:8000');",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Teste global: registra o tempo de resposta no console (não falha a requisição).",
          "console.log(pm.info.requestName + ' -> ' + pm.response.code + ' em ' + pm.response.responseTime + 'ms');"
        ]
      }
    }
  ],
