{
  "info": {
    "_postman_id": "f653b955-6beb-427e-8c2c-b1268af1bbdf",
    "name": "Ressonant API",
    "description": "Collection da Ressonant API (FastAPI) - cobre todas as rotas implementadas: Health, Auth e Users. Gerada a partir de apps/ressonant_backend/openapi.json. Variáveis de coleção: baseUrl, accessToken, userId, skip, limit, status_ativo. Faça Login (ou Register) para popular accessToken/userId automaticamente.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "description": "Liveness e readiness do processo/banco.",
      "item": [
        {
          "name": "Health (liveness)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Liveness: o processo está de pé. Não exige autenticação."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status code e 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Ready (readiness)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/ready",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health",
                "ready"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Readiness: o banco responde. Não exige autenticação."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status code e 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "description": "Cadastro público, login (salva token) e dados do autenticado.",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"usuario@example.com\",\n  \"cpf\": \"12345678901\",\n  \"telefone\": \"11987654321\",\n  \"senha\": \"SenhaForte123\",\n  \"idade\": 30,\n  \"termos_contrato\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Cadastro público de usuário comum (UserRegister). Salva {{userId}} a partir da resposta."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status code e 201\", function () { pm.response.to.have.status(201); });",
                  "try {",
                  "  const json = pm.response.json();",
                  "  if (json && json.id) { pm.collectionVariables.set('userId', json.id); }",
                  "} catch (e) { console.log('register: sem corpo JSON de resposta', e); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"usuario@example.com\",\n  \"senha\": \"SenhaForte123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Autentica por e-mail e senha (LoginRequest). Salva {{accessToken}} a partir da resposta."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status code e 200\", function () { pm.response.to.have.status(200); });",
                  "try {",
                  "  const json = pm.response.json();",
                  "  if (json && json.access_token) { pm.collectionVariables.set('accessToken', json.access_token); }",
                  "} catch (e) { console.log('login: sem corpo JSON de resposta', e); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
