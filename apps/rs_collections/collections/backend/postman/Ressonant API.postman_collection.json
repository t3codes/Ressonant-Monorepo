{
  "info": {
    "name": "Ressonant API",
    "description": "Coleção de requisições da API Ressonant (Auth, Users, Workspaces, Health). Gerada a partir do openapi.json do backend.\n\nAutenticação: JWT Bearer via header Authorization. O user_id é extraído exclusivamente do token — nunca trafegado por URL ou body.\n\nAmbientes:\n- Local Dev: http://localhost:8000\n- Homologação: https://api-homolog.ressonant.dev",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_variable_scope": "variables",
    "_postman_exported_at": "2026-11-18T16:45:00.000Z",
    "_postman_exported_using": "Postman/11.0"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health (liveness)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Liveness: o processo está de pé. Sem autenticação."
          }
        },
        {
          "name": "Ready (readiness)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/ready",
              "host": ["{{baseUrl}}"],
              "path": ["health", "ready"]
            },
            "description": "Readiness: o banco responde. Sem autenticação."
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"usuario@example.com\",\n  \"senha\": \"SenhaForte123\",\n  \"cpf\": \"12345678901\",\n  \"telefone\": \"11987654321\",\n  \"idade\": 30,\n  \"termos_contrato\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "description": "Cadastro público de usuário comum. Retorna UserResponse (sem senha_hash)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  var json = pm.response.json();",
                  "  pm.collectionVariables.set(\"userId\", json.id);",
                  "  console.log(\"userId salvo:\", json.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"usuario@example.com\",\n  \"senha\": \"SenhaForte123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Autentica por e-mail e senha. Devolve access_token JWT HS256 (30 min)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  var json = pm.response.json();",
                  "  pm.collectionVariables.set(\"accessToken\", json.access_token);",
                  "  pm.collectionVariables.set(\"expiresIn\", json.expires_in);",
                  "  console.log(\"accessToken salvo:\", json.access_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            },
            "description": "Dados do usuário autenticado. user_id extraído exclusivamente do JWT."
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Create User (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"senha\": \"SenhaForte123\",\n  \"cpf\": \"11144477735\",\n  \"telefone\": \"11987654322\",\n  \"idade\": 35,\n  \"termos_contrato\": true,\n  \"status_ativo\": true,\n  \"interno_adm\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": ["{{baseUrl}}"],
              "path": ["users"]
            },
            "description": "Cria usuário (admin apenas). Podendo definir flags administrativas."
          }
        },
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users?skip={{skip}}&limit={{limit}}&status_ativo={{status_ativo}}",
              "host": ["{{baseUrl}}"],
              "path": ["users"],
              "query": [
                {
                  "key": "skip",
                  "value": "{{skip}}",
                  "description": "Número de registros para pular (paginação)"
                },
                {
                  "key": "limit",
                  "value": "{{limit}}",
                  "description": "Máximo de registros por página (1-100)"
                },
                {
                  "key": "status_ativo",
                  "value": "{{status_ativo}}",
                  "description": "Filtrar por status ativo (true/false/omitido)"
                }
              ]
            },
            "description": "Lista usuários com paginação. Admin apenas."
          }
        },
        {
          "name": "Get User",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{userId}}"]
            },
            "description": "Busca usuário por id. Admin ou o próprio usuário (extraído do JWT)."
          }
        },
        {
          "name": "Update User",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"usuario.atualizado@example.com\",\n  \"telefone\": \"11987654323\",\n  \"idade\": 31,\n  \"termos_contrato\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{userId}}"]
            },
            "description": "Atualiza e-mail, telefone, idade e termos. Admin ou o próprio usuário. Senha, CPF e flags admin ficam fora."
          }
        },
        {
          "name": "Set User Status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status_ativo\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{userId}}", "status"]
            },
            "description": "Ativa ou desativa usuário (admin apenas)."
          }
        },
        {
          "name": "Delete User (soft delete)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{userId}}"]
            },
            "description": "Soft delete: desativa o usuário (admin apenas)."
          }
        }
      ]
    },
    {
      "name": "Workspaces",
      "item": [
        {
          "name": "Create Workspace",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Plataforma\",\n  \"slug\": \"plataforma\",\n  \"description\": \"Time de plataforma\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/workspaces",
              "host": ["{{baseUrl}}"],
              "path": ["workspaces"]
            },
            "description": "Cria workspace. O owner é o usuário autenticado (extraído do JWT — nunca enviado no body)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  var json = pm.response.json();",
                  "  pm.collectionVariables.set(\"workspaceId\", json.id);",
                  "  console.log(\"workspaceId salvo:\", json.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "List Workspaces",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/workspaces?skip={{skip}}&limit={{limit}}&status_ativo={{status_ativo}}",
              "host": ["{{baseUrl}}"],
              "path": ["workspaces"],
              "query": [
                {
                  "key": "skip",
                  "value": "{{skip}}",
                  "description": "Número de registros para pular (paginação)"
                },
                {
                  "key": "limit",
                  "value": "{{limit}}",
                  "description": "Máximo de registros por página (1-100)"
                },
                {
                  "key": "status_ativo",
                  "value": "{{status_ativo}}",
                  "description": "Filtrar por status ativo (true/false/omitido)"
                }
              ]
            },
            "description": "Lista workspaces do usuário autenticado (dono ou membro)."
          }
        },
        {
          "name": "Get Workspace",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/workspaces/{{workspaceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["workspaces", "{{workspaceId}}"]
            },
            "description": "Busca workspace por id. Apenas se o usuário é membro."
          }
        },
        {
          "name": "Update Workspace",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Plataforma Atualizada\",\n  \"description\": \"Time de plataforma - atualizado\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/workspaces/{{workspaceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["workspaces", "{{workspaceId}}"]
            },
            "description": "Atualiza workspace. Apenas owner ou admin do workspace. owner_id e slug não podem ser alterados."
          }
        },
        {
          "name": "Set Workspace Status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status_ativo\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/workspaces/{{workspaceId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["workspaces", "{{workspaceId}}", "status"]
            },
            "description": "Ativa ou desativa workspace. Apenas o owner."
          }
        },
        {
          "name": "Add Workspace Member",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"{{memberUserId}}\",\n  \"role\": \"member\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/workspaces/{{workspaceId}}/members",
              "host": ["{{baseUrl}}"],
              "path": ["workspaces", "{{workspaceId}}", "members"]
            },
            "description": "Adiciona membro ao workspace. Apenas owner ou admin do workspace. role: admin | member | viewer."
          }
        }
      ]
    }
