# Específico do backend. Postgres e Grafana ficam no .env da raiz (.env.example lá).
# `make setup` cria o .env e gera AUTH_SECRET.

# Rodando FORA do Docker (make up). No Docker o compose sobrescreve com o host `postgres`.
# Use as mesmas credenciais POSTGRES_* do .env da raiz.
DATABASE_URL=postgresql+psycopg2://ressonant:change-me@localhost:5432/ressonant

# Obrigatório, mín. 32 caracteres (o app não sobe sem). `make setup` gera um valor aleatório.
AUTH_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ENVIRONMENT=development

# Telemetria (opentelemetry-instrument). O collector é alcançado pelo nome na rede `telemetry`.
# Cada processo do app precisa de OTEL_SERVICE_NAME próprio.
OTEL_SERVICE_NAME=ressonant_backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_EXPORTER=otlp_proto_http
OTEL_METRICS_EXPORTER=otlp_proto_http
OTEL_LOGS_EXPORTER=none
OTEL_METRIC_EXPORT_INTERVAL=10000
OTEL_PYTHON_DISABLED_INSTRUMENTATIONS=logging

# Primeiro admin (make migrate/create-admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_CPF=
