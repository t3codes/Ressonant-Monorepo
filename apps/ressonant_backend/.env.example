# Específico do backend. Postgres e Grafana ficam no .env da raiz (.env.example lá).
# `make setup` cria o .env e gera AUTH_SECRET.

# Rodando FORA do Docker (make up). No Docker o compose sobrescreve com o host `postgres`.
# Use as mesmas credenciais POSTGRES_* do .env da raiz.
DATABASE_URL=postgresql+psycopg2://ressonant:change-me@localhost:5432/ressonant

# Obrigatório, mín. 32 caracteres (o app não sobe sem). `make setup` gera um valor aleatório.
AUTH_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Opcional: revogação de access token entre processos. Sem REDIS_URL, a blacklist é em memória.
REDIS_URL=
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ENVIRONMENT=development
# ENV é aceito como fallback de ENVIRONMENT pelo common-logs.
LOG_LEVEL=
DEPENDENCIES_LOGGER_LEVEL=
# Porta do uvicorn quando a API roda direto (app.main:__main__); no Compose, use BACKEND_PORT na .env da raiz.
PORT=8000

# Armazenamento opcional de imagens em AWS S3/LocalStack. Sem bucket, o serviço usa disco local.
AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1
AWS_S3_ENDPOINT_URL=

# Telemetria (opentelemetry-instrument). O collector é alcançado pelo nome na rede `telemetry`.
# Cada processo do app precisa de OTEL_SERVICE_NAME próprio.
OTEL_SERVICE_NAME=ressonant_backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_EXPORTER=otlp_proto_http
OTEL_METRICS_EXPORTER=otlp_proto_http
OTEL_LOGS_EXPORTER=none
OTEL_METRIC_EXPORT_INTERVAL=10000
OTEL_PYTHON_DISABLED_INSTRUMENTATIONS=logging

# Datadog é opcional e fica desligado por padrão. Credenciais/Agent são configurados no runtime.
DD_TRACE_ENABLED=false
DD_SERVICE=ressonant_backend
DD_ENV=development
DD_VERSION=
DD_AGENT_HOST=localhost
DD_TRACE_AGENT_PORT=8126
DD_LOGS_INJECTION=true
DD_RUNTIME_METRICS_ENABLED=true

# Primeiro admin (make migrate/create-admin). ADMIN_TELEFONE tem default no script.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_CPF=
ADMIN_TELEFONE=

# Planejado — Fase 0/1 (D1): VITE_API_BASE_URL e VITE_DATA_MODE são variáveis do frontend
# e ainda não existem; não adicione VITE_* aqui. Tampouco há variáveis de
# organizations/plans neste backend — esses domínios são Planejado — Fase 0/1.
